# Postgres connection string, shaped like
#   postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Both postgres:// and postgresql:// forms work; sslmode/channel_binding
# params are normalized automatically for the asyncpg driver, and remote
# hosts default to SSL.
#   Local compose DB (passwordless): postgresql://rptw@localhost:5455/rptw
#   Neon:   Dashboard -> your project -> Connect
#   Heroku: set automatically when you attach the heroku-postgresql add-on
DATABASE_URL=

# Bearer token the publishing desk uses for POST/PUT/DELETE.
# Same semantics as the Next.js ADMIN_TOKEN — generate a long random
# value, e.g.:  openssl rand -hex 32
ADMIN_TOKEN=change-me

# Comma-separated origins allowed to call this API from the browser.
CORS_ORIGINS=http://localhost:3000,https://repentandpreparetheway.org

# ── Hosting ───────────────────────────────────────────────────────────
# DYNO and WEB_CONCURRENCY are set by Heroku itself — leave them unset
# locally. Schema creation follows the host: on boot in development, in
# the release phase (scripts/release.py) on Heroku. Set this only to
# override that choice.
# CREATE_TABLES_ON_BOOT=true

# Connections the database plan allows in total (Heroku Essential-0: 20,
# Essential-1: 40). The per-worker pool is divided to fit inside it, so
# raise this when you upgrade the plan.
# DB_CONNECTION_LIMIT=20
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
